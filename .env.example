# Không commit file .env thật. Copy sang .env và điền giá trị.
NODE_ENV=development
PORT_API=8080
PORT_GAMESERVER=8443
DATABASE_URL=postgres://tactical:tactical@localhost:5432/tactical
REDIS_URL=redis://localhost:6379
JWT_ISSUER=https://tactical-strike.local
