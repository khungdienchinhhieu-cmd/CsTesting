{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "**/*.ts",
    "../packages/shared/src/**/*.ts",
    "../packages/bots/src/**/*.ts"
  ]
}