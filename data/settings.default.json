  "hud": {
    "crosshair": {
      "style": "classic",
      "size": 6,
      "gap": 3,
      "thickness": 1.5,
      "color": "#5cf07a",
      "outline": true,
      "dot": false
    },
    "showFps": false,
    "showNetGraph": false,
    "radarZoom": 1.0,
    "hudScale": 1.0
