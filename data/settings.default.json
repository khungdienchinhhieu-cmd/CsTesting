  "keybinds": {
    "forward": "KeyW",
    "back": "KeyS",
    "left": "KeyA",
    "right": "KeyD",
    "jump": "Space",
    "crouch": "ControlLeft",
    "walk": "ShiftLeft",
    "use": "KeyE",
    "reload": "KeyR",
    "drop": "KeyG",
    "inspect": "KeyF",
    "slotPrimary": "Digit1",
    "slotSecondary": "Digit2",
    "slotKnife": "Digit3",
    "slotGrenade": "Digit4",
    "scope": "Mouse2",
    "buyMenu": "KeyB",
    "scoreboard": "Tab",
    "teamChat": "KeyY",
    "allChat": "KeyU",
    "radio": "KeyX",
    "toggleConsole": "Backquote",
    "debugOverlay": "F3",
    "pushToTalk": "KeyV"
