{
  "version": 1,
  "sensitivity": 2.2,
  "zoomSensitivityMultiplier": 0.85,
  "fov": 90,
  "viewmodelFov": 68,
  "invertY": false,
  "rawInput": true,
  "audio": {
    "master": 0.8,
    "sfx": 0.9,
    "music": 0.5,
    "voice": 0.8,
    "ui": 0.7
  },
  "graphics": {
    "preset": "medium",
    "resolutionScale": 1.0,
    "dynamicResolution": true,
    "targetFps": 144,
    "vsync": false,
    "taa": true,
    "sharpen": true,
    "bloom": 0.25,
    "lut": true,
    "ssr": false,
    "gtao": true,
    "motionBlur": false,
    "filmGrain": false,
    "chromaticAberration": false,
    "depthOfFieldMenus": true,
    "anisotropy": 8,
    "smokeQuality": "volumetric",
    "particleQuality": "normal",
    "shadowQuality": "csm2",
    "ragdolls": false,
    "hdr": false
